# Copy to .env and change the values. Never commit .env (it's in .gitignore).
# 12-factor: config lives in the environment, not in the code.
DATABASE_PATH=database/club.db
FLASK_DEBUG=1
# SECRET_KEY=change-me-to-a-long-random-string   # needed once you add sessions / login
# PAYMENT_API_KEY=                               # example of a secret that must never be committed
